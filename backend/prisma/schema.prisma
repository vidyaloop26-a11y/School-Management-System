// Canonical Multi-Tenant Schema for Vidyaloop Platform
// Database: MongoDB via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  superAdmin
  schoolAdmin
  teacher
  parent
}

enum StaffRole {
  Teacher
  SeniorTeacher
  VicePrincipal
  Principal
  FrontOffice
  Accountant
  Librarian
  LabAssistant
}

// ---------------------------------------------------------------------------
// School (Tenant) & Settings
// ---------------------------------------------------------------------------

model School {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  code      String   @unique
  logoUrl   String?
  board     String?  // CBSE | ICSE | State ...
  address   String?
  session   String   @default("2024-2025")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  students          Student[]
  staff             Staff[]
  schoolSettings    SchoolSettings?
  schoolClasses     SchoolClass[]
  schoolSubjects    SchoolSubject[]
  examConfigs       ExamConfig[]
  feeComponents     FeeComponent[]
  feeStructures     FeeStructure[]
  studentFeeLedgers StudentFeeLedger[]
  payments          Payment[]
  timetableEntries  TimetableEntry[]
  attendanceRecords AttendanceRecord[]
  examMarks         ExamMark[]
}

model SchoolSettings {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @unique @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term      Int      @default(2)
  grading   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SchoolClass {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cls       String
  section   String
  createdAt DateTime @default(now())

  @@unique([schoolId, cls, section])
  @@index([schoolId])
}

model SchoolSubject {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([schoolId, name])
  @@index([schoolId])
}

model ExamConfig {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term      String
  createdAt DateTime @default(now())

  @@unique([schoolId, term])
}

// ---------------------------------------------------------------------------
// Identity & Access Control (User, Role, Refresh Tokens)
// ---------------------------------------------------------------------------

model User {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  email              String   @unique
  username           String   @unique
  passwordHash       String
  role               Role
  name               String
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)

  schoolId           String?  @db.ObjectId
  school             School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentId          String?  @unique @db.ObjectId
  student            Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  staffId            String?  @unique @db.ObjectId
  staff              Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  refreshTokens      RefreshToken[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([schoolId, role])
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Academic Entities (Student, Staff)
// ---------------------------------------------------------------------------

model Student {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String   @db.ObjectId
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  admNo       String
  name        String
  cls         String
  section     String
  roll        Int?
  session     String   @default("2024-2025")
  batch       String?  @default("2020-2025")
  dob         String?
  bloodGroup  String?
  fatherName  String?
  fatherPhone String?
  fatherEmail String?
  motherName  String?
  emergency   String?
  address     String?
  status      String   @default("Active")

  user        User?
  ledgers     StudentFeeLedger[]
  payments    Payment[]
  attendance  AttendanceRecord[]
  examMarks   ExamMark[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, admNo])
  @@index([schoolId, cls, section])
  @@index([schoolId, session])
}

model Staff {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId      String   @db.ObjectId
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  staffId       String
  name          String
  jobTitle      String
  dept          String?
  subject       String?
  qualification String?
  email         String?
  phone         String?
  status        String   @default("Active")
  joined        String?

  user          User?
  timetable     TimetableEntry[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([schoolId, staffId])
  @@index([schoolId, dept])
}

// ---------------------------------------------------------------------------
// Fee & Finance Engine
// ---------------------------------------------------------------------------

model FeeComponent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  type      String   @default("Annual")
  createdAt DateTime @default(now())

  @@unique([schoolId, name])
}

model FeeStructure {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cls       String
  session   String   @default("2024-2025")
  amount    Float
  createdAt DateTime @default(now())

  @@unique([schoolId, cls, session])
}

model StudentFeeLedger {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String   @db.ObjectId
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session   String   @default("2024-2025")
  term      String
  amount    Float
  dueDate   DateTime
  paid      Float    @default(0)
  status    String   @default("UNPAID")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, studentId])
}

model Payment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String   @db.ObjectId
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId   String   @db.ObjectId
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount      Float
  paymentMode String   @default("ONLINE")
  receiptNo   String   @unique
  paidAt      DateTime @default(now())
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Timetable
// ---------------------------------------------------------------------------

model TimetableEntry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cls       String
  section   String
  day       String
  period    String
  subject   String
  room      String?
  staffId   String?  @db.ObjectId
  staff     Staff?   @relation(fields: [staffId], references: [id])
  createdAt DateTime @default(now())

  @@unique([schoolId, cls, section, day, period])
  @@index([schoolId, staffId])
  @@index([schoolId, cls, section])
}

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------

model AttendanceRecord {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId   String   @db.ObjectId
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId  String   @db.ObjectId
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cls        String
  section    String
  date       DateTime
  status     String
  markedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([studentId, date])
  @@index([schoolId, cls, section, date])
}

// ---------------------------------------------------------------------------
// Examination & Marks
// ---------------------------------------------------------------------------

model ExamMark {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId      String   @db.ObjectId
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId     String   @db.ObjectId
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session       String   @default("2024-2025")
  term          String   @default("Mid-Term")
  cls           String
  section       String
  subject       String
  marksObtained Float
  maxMarks      Float    @default(100)
  grade         String?
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([studentId, session, term, subject])
  @@index([schoolId, cls, section, session, term])
}
