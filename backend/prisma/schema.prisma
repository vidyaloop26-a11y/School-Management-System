// Canonical Multi-Tenant Schema for Vidyaloop Platform
// Database: MongoDB via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  superAdmin
  schoolAdmin
  staff
  parent
}

// Functional duties a staff account may hold (checkbox model — one person can
// hold several, e.g. teacher + librarian). schoolAdmin/superAdmin bypass duty
// checks; parents never carry duties.
enum Duty {
  principal
  vicePrincipal
  hod
  teacher
  examCoordinator
  accountant
  frontOffice
  librarian
  transportIncharge
  warden
  hrManager
  admissionsOfficer
  itAdmin
}

enum StaffRole {
  Teacher
  SeniorTeacher
  VicePrincipal
  Principal
  FrontOffice
  Accountant
  Librarian
  LabAssistant
}

// ---------------------------------------------------------------------------
// School (Tenant) & Settings
// ---------------------------------------------------------------------------

model School {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  code      String   @unique
  logoUrl   String?
  board     String?  // CBSE | ICSE | State ...
  address   String?
  session   String   @default("2024-2025")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  students          Student[]
  staff             Staff[]
  schoolSettings    SchoolSettings?
  schoolClasses     SchoolClass[]
  schoolSubjects    SchoolSubject[]
  examConfigs       ExamConfig[]
  feeComponents     FeeComponent[]
  feeStructures     FeeStructure[]
  studentFeeLedgers StudentFeeLedger[]
  payments          Payment[]
  timetableEntries  TimetableEntry[]
  attendanceRecords AttendanceRecord[]
   examMarks         ExamMark[]
   admissionInquiries AdmissionInquiry[]
   notices            Notice[]
   payrollRecords     PayrollRecord[]
   incomeExpenseRecords IncomeExpenseRecord[]
   certificateRecords CertificateRecord[]
   leaveRequests      LeaveRequest[]
   schoolEvents       SchoolEvent[]
}

model SchoolSettings {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId        String   @unique @db.ObjectId
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term            Int      @default(2)
  grading         String?
  academicSession String   @default("2024-2025")
  days            String[] @default(["Mon","Tue","Wed","Thu","Fri"])
  periods         Json     @default("[{\"label\":\"P1\",\"time\":\"08:30-09:15\"},{\"label\":\"P2\",\"time\":\"09:15-10:00\"},{\"label\":\"P3\",\"time\":\"10:00-10:45\"},{\"label\":\"P4\",\"time\":\"11:00-11:45\"},{\"label\":\"P5\",\"time\":\"11:45-12:30\"}]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SchoolEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title     String
  sub       String?
  date      DateTime
  type      String   @default("Event") // Event | Holiday
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, date])
  @@index([schoolId, type])
}

model SchoolClass {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cls       String
  section   String
  createdAt DateTime @default(now())

  @@unique([schoolId, cls, section])
  @@index([schoolId])
}

model SchoolSubject {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([schoolId, name])
  @@index([schoolId])
}

model ExamConfig {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term      String
  createdAt DateTime @default(now())

  @@unique([schoolId, term])
}

// ---------------------------------------------------------------------------
// Admissions (Inquiry pipeline, linked to enrollment)
// ---------------------------------------------------------------------------

enum AdmissionStage {
  inquiry
  docs
  interaction
  enrolled
  rejected
}

model AdmissionInquiry {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  schoolId     String        @db.ObjectId
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name         String
  classApplied String
  parentName   String
  phone        String
  email        String?
  prevSchool   String?
  stage        AdmissionStage @default(inquiry)
  status       String        @default("Active")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([schoolId, stage])
  @@index([schoolId, status])
}

// ---------------------------------------------------------------------------
// Communication (Notice board — school/class scoped)
// ---------------------------------------------------------------------------

enum NoticeAudience {
  all
  class
}

model Notice {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String        @db.ObjectId
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  body        String
  audience    NoticeAudience @default(all)
  cls         String?
  section     String?
  createdById String?       @db.ObjectId
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([schoolId, createdAt])
}

// ---------------------------------------------------------------------------
// Identity & Access Control (User, Role, Refresh Tokens)
// ---------------------------------------------------------------------------

model User {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  email              String   @unique
  username           String   @unique
  passwordHash       String
  role               Role
  duties             Duty[]
  name               String
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)

  schoolId           String?  @db.ObjectId
  school             School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentId          String?  @unique @db.ObjectId
  student            Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  staffId            String?  @unique @db.ObjectId
  staff              Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  refreshTokens      RefreshToken[]
  notices            Notice[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([schoolId, role])
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Platform-level audit trail. Every privileged cross-school access (support
// lookups by superAdmin) is recorded here.
model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId    String
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  schoolId   String?  @db.ObjectId
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([schoolId, createdAt])
}

// ---------------------------------------------------------------------------
// Academic Entities (Student, Staff)
// ---------------------------------------------------------------------------

model Student {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String   @db.ObjectId
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  admNo       String
  name        String
  cls         String
  section     String
  roll        Int?
  session     String   @default("2024-2025")
  batch       String?  @default("2020-2025")
  dob         String?
  bloodGroup  String?
  fatherName  String?
  fatherPhone String?
  fatherEmail String?
  motherName  String?
  emergency   String?
  address     String?
  status      String   @default("Active")

  user        User?
  ledgers     StudentFeeLedger[]
  payments    Payment[]
  attendance  AttendanceRecord[]
  examMarks   ExamMark[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, admNo])
  @@index([schoolId, cls, section])
  @@index([schoolId, session])
}

model Staff {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId      String   @db.ObjectId
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  staffId       String
  name          String
  jobTitle      String
  dept          String?
  subject       String?
  qualification String?
  email         String?
  phone         String?
  assignedClass String?
  assignedSection String?
  status        String   @default("Active")
  joined        String?
  salary        Float?

  user          User?
  timetable     TimetableEntry[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([schoolId, staffId])
  @@index([schoolId, dept])
}

// ---------------------------------------------------------------------------
// Fee & Finance Engine
// ---------------------------------------------------------------------------

model FeeComponent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  type      String   @default("Annual")
  createdAt DateTime @default(now())

  @@unique([schoolId, name])
}

model FeeStructure {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cls       String
  session   String   @default("2024-2025")
  amount    Float
  createdAt DateTime @default(now())

  @@unique([schoolId, cls, session])
}

model StudentFeeLedger {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String   @db.ObjectId
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session   String   @default("2024-2025")
  term      String
  amount    Float
  dueDate   DateTime
  paid      Float    @default(0)
  status    String   @default("UNPAID")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, studentId])
}

model Payment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String   @db.ObjectId
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId   String   @db.ObjectId
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount      Float
  paymentMode String   @default("ONLINE")
  receiptNo   String   @unique
  paidAt      DateTime @default(now())
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Timetable
// ---------------------------------------------------------------------------

model TimetableEntry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cls       String
  section   String
  day       String
  period    String
  subject   String
  room      String?
  staffId   String?  @db.ObjectId
  staff     Staff?   @relation(fields: [staffId], references: [id])
  createdAt DateTime @default(now())

  @@unique([schoolId, cls, section, day, period])
  @@index([schoolId, staffId])
  @@index([schoolId, cls, section])
}

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------

model AttendanceRecord {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId   String   @db.ObjectId
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId  String   @db.ObjectId
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cls        String
  section    String
  date       DateTime
  status     String
  markedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([studentId, date])
  @@index([schoolId, cls, section, date])
}

// ---------------------------------------------------------------------------
// Examination & Marks
// ---------------------------------------------------------------------------

model ExamMark {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId      String   @db.ObjectId
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId     String   @db.ObjectId
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session       String   @default("2024-2025")
  term          String   @default("Mid-Term")
  cls           String
  section       String
  subject       String
  marksObtained Float
  maxMarks      Float    @default(100)
  grade         String?
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([studentId, session, term, subject])
  @@index([schoolId, cls, section, session, term])
}

// ---------------------------------------------------------------------------
// Administration: Payroll, Finance, Certificates, Leave
// ---------------------------------------------------------------------------

model PayrollRecord {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String   @db.ObjectId
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffId     String
  staffName   String
  role        String
  month       String   // e.g. "August 2026"
  basicSalary Float
  allowances  Float    @default(0)
  deductions  Float    @default(0)
  netSalary   Float
  status      String   @default("PAID") // PAID | PENDING | PROCESSING
  paymentDate DateTime @default(now())
  paymentMode String   @default("BANK_TRANSFER")
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId, month])
  @@index([schoolId, staffId])
}

model IncomeExpenseRecord {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId      String   @db.ObjectId
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type          String   // INCOME | EXPENSE
  category      String   // Tuition Fees, Maintenance, Utilities, Salaries, Events, Grants
  title         String
  amount        Float
  date          DateTime @default(now())
  voucherNo     String
  paymentMethod String   @default("BANK_TRANSFER") // CASH | BANK_TRANSFER | UPI | CHEQUE
  recordedBy    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId, type])
  @@index([schoolId, category])
}

model CertificateRecord {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId      String   @db.ObjectId
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId     String
  studentName   String
  cls           String
  section       String
  type          String   // Transfer Certificate | Character Certificate | Bonafide Certificate | Merit Certificate
  certificateNo String
  issueDate     DateTime @default(now())
  status        String   @default("ISSUED") // REQUESTED | DRAFT | ISSUED | REJECTED
  reason        String?
  conduct       String?  @default("Good")
  remarks       String?
  issuedBy      String?
  requestedBy   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId, studentId])
  @@index([schoolId, type])
}

model LeaveRequest {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId      String   @db.ObjectId
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  applicantType String   // STAFF | STUDENT
  applicantId   String
  applicantName String
  roleOrClass   String   // e.g. "Teacher" or "8-A"
  leaveType     String   // Casual, Sick, Privilege, Maternity, Emergency
  startDate     DateTime
  endDate       DateTime
  totalDays     Int
  reason        String
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  actionBy      String?
  actionComment String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId, applicantType])
  @@index([schoolId, status])
}

