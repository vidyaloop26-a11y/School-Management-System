// Canonical Multi-Tenant Schema for Vidyaloop Platform
// Database: MongoDB via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  superAdmin
  schoolAdmin
  staff
  parent
}

// Functional duties a staff account may hold (checkbox model — one person can
// hold several, e.g. teacher + librarian). schoolAdmin/superAdmin bypass duty
// checks; parents never carry duties.
enum Duty {
  principal
  vicePrincipal
  hod
  teacher
  examCoordinator
  accountant
  frontOffice
  librarian
  transportIncharge
  warden
  hrManager
  admissionsOfficer
  itAdmin
}

enum StaffRole {
  Teacher
  SeniorTeacher
  VicePrincipal
  Principal
  FrontOffice
  Accountant
  Librarian
  LabAssistant
}

// ---------------------------------------------------------------------------
// School (Tenant) & Settings
// ---------------------------------------------------------------------------

model School {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  code      String   @unique
  logoUrl   String?
  board     String?  // CBSE | ICSE | State ...
  address   String?
  session   String   @default("2024-2025")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  students          Student[]
  staff             Staff[]
  schoolSettings    SchoolSettings?
  schoolClasses     SchoolClass[]
  schoolSubjects    SchoolSubject[]
  examConfigs       ExamConfig[]
  feeComponents     FeeComponent[]
  feeStructures     FeeStructure[]
  studentFeeLedgers StudentFeeLedger[]
  payments          Payment[]
  timetableEntries  TimetableEntry[]
  attendanceRecords AttendanceRecord[]
   examMarks         ExamMark[]
   admissionInquiries AdmissionInquiry[]
   notices            Notice[]
   payrollRecords     PayrollRecord[]
   incomeExpenseRecords IncomeExpenseRecord[]
   certificateRecords CertificateRecord[]
   leaveRequests      LeaveRequest[]
   schoolEvents       SchoolEvent[]
  tasks              Task[]
  syllabusTopics     SyllabusTopic[]
  albums             Album[]
  books              Book[]
  bookIssues         BookIssue[]
  transportRoutes    TransportRoute[]
  vehicles           Vehicle[]
  visitors           Visitor[]
  gatePasses         GatePass[]
  inventoryItems     InventoryItem[]
  purchaseRecords    PurchaseRecord[]
  issueLogs          IssueLog[]
   buildings          Building[]
   maintenanceRequests MaintenanceRequest[]
   copyCheckBatches   CopyCheckBatch[]
   studentRoutes      StudentRoute[]
   hostMappings       HostMapping[]
}

model SchoolSettings {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId        String   @unique @db.ObjectId
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term            Int      @default(2)
  grading         String?
  academicSession String   @default("2024-2025")
  days            String[] @default(["Mon","Tue","Wed","Thu","Fri"])
  periods         Json     @default("[{\"label\":\"P1\",\"time\":\"08:30-09:15\"},{\"label\":\"P2\",\"time\":\"09:15-10:00\"},{\"label\":\"P3\",\"time\":\"10:00-10:45\"},{\"label\":\"P4\",\"time\":\"11:00-11:45\"},{\"label\":\"P5\",\"time\":\"11:45-12:30\"}]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SchoolEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title     String
  sub       String?
  date      DateTime
  type      String   @default("Event") // Event | Holiday
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, date])
  @@index([schoolId, type])
}

model SchoolClass {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cls       String
  section   String
  createdAt DateTime @default(now())

  @@unique([schoolId, cls, section])
  @@index([schoolId])
}

model SchoolSubject {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([schoolId, name])
  @@index([schoolId])
}

model ExamConfig {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term      String
  createdAt DateTime @default(now())

  @@unique([schoolId, term])
}

// ---------------------------------------------------------------------------
// Admissions (Inquiry pipeline, linked to enrollment)
// ---------------------------------------------------------------------------

enum AdmissionStage {
  inquiry
  docs
  interaction
  enrolled
  rejected
}

model AdmissionInquiry {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  schoolId     String        @db.ObjectId
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name         String
  classApplied String
  parentName   String
  phone        String
  email        String?
  prevSchool   String?
  stage        AdmissionStage @default(inquiry)
  status       String        @default("Active")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([schoolId, stage])
  @@index([schoolId, status])
}

// ---------------------------------------------------------------------------
// Communication (Notice board — school/class scoped)
// ---------------------------------------------------------------------------

enum NoticeAudience {
  all
  class
}

model Notice {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String        @db.ObjectId
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  body        String
  audience    NoticeAudience @default(all)
  cls         String?
  section     String?
  createdById String?       @db.ObjectId
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([schoolId, createdAt])
}

// ---------------------------------------------------------------------------
// Identity & Access Control (User, Role, Refresh Tokens)
// ---------------------------------------------------------------------------

model User {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  email              String   @unique
  username           String   @unique
  passwordHash       String
  role               Role
  duties             Duty[]
  name               String
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)

  schoolId           String?  @db.ObjectId
  school             School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentId          String?  @db.ObjectId
  student            Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  staffId            String?  @db.ObjectId
  staff              Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  refreshTokens      RefreshToken[]
  notices            Notice[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([schoolId, role])
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Platform-level audit trail. Every privileged cross-school access (support
// lookups by superAdmin) is recorded here.
model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId    String
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  schoolId   String?  @db.ObjectId
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([schoolId, createdAt])
}

// ---------------------------------------------------------------------------
// Academic Entities (Student, Staff)
// ---------------------------------------------------------------------------

model Student {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String   @db.ObjectId
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  admNo       String
  name        String
  cls         String
  section     String
  roll        Int?
  session     String   @default("2024-2025")
  batch       String?  @default("2020-2025")
  dob         String?
  bloodGroup  String?
  fatherName  String?
  fatherPhone String?
  fatherEmail String?
  motherName  String?
  emergency   String?
  address     String?
  status      String   @default("Active")

  users        User[]
  ledgers     StudentFeeLedger[]
  payments    Payment[]
  attendance  AttendanceRecord[]
  examMarks   ExamMark[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, admNo])
  @@index([schoolId, cls, section])
  @@index([schoolId, session])
}

model Staff {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId      String   @db.ObjectId
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  staffId       String
  name          String
  jobTitle      String
  dept          String?
  subject       String?
  qualification String?
  email         String?
  phone         String?
  assignedClass String?
  assignedSection String?
  status        String   @default("Active")
  joined        String?
  salary        Float?

  users            User[]
  timetable     TimetableEntry[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([schoolId, staffId])
  @@index([schoolId, dept])
}

// ---------------------------------------------------------------------------
// Fee & Finance Engine
// ---------------------------------------------------------------------------

model FeeComponent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  type      String   @default("Annual")
  createdAt DateTime @default(now())

  @@unique([schoolId, name])
}

model FeeStructure {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cls       String
  session   String   @default("2024-2025")
  amount    Float
  createdAt DateTime @default(now())

  @@unique([schoolId, cls, session])
}

model StudentFeeLedger {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String   @db.ObjectId
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session   String   @default("2024-2025")
  term      String
  amount    Float
  dueDate   DateTime
  paid      Float    @default(0)
  status    String   @default("UNPAID")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, studentId])
}

model Payment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String   @db.ObjectId
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId   String   @db.ObjectId
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount      Float
  paymentMode String   @default("ONLINE")
  receiptNo   String   @unique
  paidAt      DateTime @default(now())
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Timetable
// ---------------------------------------------------------------------------

model TimetableEntry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cls       String
  section   String
  day       String
  period    String
  subject   String
  room      String?
  staffId   String?  @db.ObjectId
  staff     Staff?   @relation(fields: [staffId], references: [id])
  createdAt DateTime @default(now())

  @@unique([schoolId, cls, section, day, period])
  @@index([schoolId, staffId])
  @@index([schoolId, cls, section])
}

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------

model AttendanceRecord {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId   String   @db.ObjectId
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId  String   @db.ObjectId
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cls        String
  section    String
  date       DateTime
  status     String
  markedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([studentId, date])
  @@index([schoolId, cls, section, date])
}

// ---------------------------------------------------------------------------
// Examination & Marks
// ---------------------------------------------------------------------------

model ExamMark {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId      String   @db.ObjectId
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId     String   @db.ObjectId
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session       String   @default("2024-2025")
  term          String   @default("Mid-Term")
  cls           String
  section       String
  subject       String
  marksObtained Float
  maxMarks      Float    @default(100)
  grade         String?
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([studentId, session, term, subject])
  @@index([schoolId, cls, section, session, term])
}

// ---------------------------------------------------------------------------
// Administration: Payroll, Finance, Certificates, Leave
// ---------------------------------------------------------------------------

model PayrollRecord {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String   @db.ObjectId
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffId     String
  staffName   String
  role        String
  month       String   // e.g. "August 2026"
  basicSalary Float
  allowances  Float    @default(0)
  deductions  Float    @default(0)
  netSalary   Float
  status      String   @default("PAID") // PAID | PENDING | PROCESSING
  paymentDate DateTime @default(now())
  paymentMode String   @default("BANK_TRANSFER")
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId, month])
  @@index([schoolId, staffId])
}

model IncomeExpenseRecord {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId      String   @db.ObjectId
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type          String   // INCOME | EXPENSE
  category      String   // Tuition Fees, Maintenance, Utilities, Salaries, Events, Grants
  title         String
  amount        Float
  date          DateTime @default(now())
  voucherNo     String
  paymentMethod String   @default("BANK_TRANSFER") // CASH | BANK_TRANSFER | UPI | CHEQUE
  recordedBy    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId, type])
  @@index([schoolId, category])
}

model CertificateRecord {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId      String   @db.ObjectId
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId     String
  studentName   String
  cls           String
  section       String
  type          String   // Transfer Certificate | Character Certificate | Bonafide Certificate | Merit Certificate
  certificateNo String
  issueDate     DateTime @default(now())
  status        String   @default("ISSUED") // REQUESTED | DRAFT | ISSUED | REJECTED
  reason        String?
  conduct       String?  @default("Good")
  remarks       String?
  issuedBy      String?
  requestedBy   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId, studentId])
  @@index([schoolId, type])
}

model LeaveRequest {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId      String   @db.ObjectId
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  applicantType String   // STAFF | STUDENT
  applicantId   String
  applicantName String
  roleOrClass   String   // e.g. "Teacher" or "8-A"
  leaveType     String   // Casual, Sick, Privilege, Maternity, Emergency
  startDate     DateTime
  endDate       DateTime
  totalDays     Int
  reason        String
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  actionBy      String?
  actionComment String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId, applicantType])
  @@index([schoolId, status])
}

// ---------------------------------------------------------------------------
// Task Management
// ---------------------------------------------------------------------------

model Task {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId      String   @db.ObjectId
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  assigneeId    String?  @db.ObjectId
  assigneeName  String?
  assignedById  String?  @db.ObjectId
  assignedByName String?
  dueDate       DateTime?
  priority      String   @default("MEDIUM")
  status        String   @default("PENDING")
  category      String?
  checklist     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId, assigneeId])
  @@index([schoolId, status])
}

// ---------------------------------------------------------------------------
// Syllabus & Lesson Progress Tracking
// ---------------------------------------------------------------------------

model SyllabusTopic {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId      String   @db.ObjectId
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject       String
  cls           String
  section       String
  topicName     String
  targetDate    DateTime?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  progress      LessonProgress[]

  @@index([schoolId, cls, section, subject])
}

model LessonProgress {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  topicId       String   @db.ObjectId
  topic         SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  teacherId     String?  @db.ObjectId
  teacherName   String?
  completedDate DateTime?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([topicId])
}

// ---------------------------------------------------------------------------
// Gallery
// ---------------------------------------------------------------------------

model Album {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String   @db.ObjectId
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  description String?
  eventDate   DateTime?
  coverUrl    String?
  visibility  String   @default("PUBLIC")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photos      Photo[]

  @@index([schoolId, eventDate])
}

model Photo {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  albumId     String   @db.ObjectId
  album       Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url         String
  caption     String?
  uploadedBy  String?
  createdAt   DateTime @default(now())

  @@index([albumId])
}

// ---------------------------------------------------------------------------
// Library Management
// ---------------------------------------------------------------------------

model Book {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId        String   @db.ObjectId
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  isbn            String?
  title           String
  author          String?
  category        String?
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  location        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  issues          BookIssue[]

  @@index([schoolId, title])
}

model BookIssue {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String    @db.ObjectId
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bookId      String    @db.ObjectId
  book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  studentId   String?   @db.ObjectId
  staffId     String?   @db.ObjectId
  issueDate   DateTime  @default(now())
  dueDate     DateTime
  returnDate  DateTime?
  fineAmount  Float     @default(0)
  finePaid    Boolean   @default(false)
  status      String    @default("ISSUED")
  createdAt   DateTime  @default(now())

  @@index([schoolId, bookId])
  @@index([schoolId, studentId])
  @@index([schoolId, status])
}

// ---------------------------------------------------------------------------
// Transport Management
// ---------------------------------------------------------------------------

model TransportRoute {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String   @db.ObjectId
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  stops       Json
  vehicleId   String?  @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments StudentRoute[]

  @@index([schoolId])
}

model Vehicle {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId        String   @db.ObjectId
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plateNumber     String
  type            String   @default("Bus")
  capacity        Int?
  driverName      String?
  driverPhone     String?
  permitExpiry    DateTime?
  insuranceExpiry DateTime?
  status          String   @default("Active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId])
}

model StudentRoute {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String   @db.ObjectId
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId   String   @db.ObjectId
  routeId     String   @db.ObjectId
  route       TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopName    String
  monthlyFee  Float    @default(0)
  createdAt   DateTime @default(now())

  @@index([schoolId, studentId])
}

// ---------------------------------------------------------------------------
// Front Office
// ---------------------------------------------------------------------------

model Visitor {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId      String   @db.ObjectId
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  photoUrl      String?
  purpose       String
  hostStaffId   String?  @db.ObjectId
  hostStaffName String?
  studentId     String?  @db.ObjectId
  studentName   String?
  checkInTime   DateTime @default(now())
  checkOutTime  DateTime?
  gatePassId    String?
  status        String   @default("CHECKED_IN")
  createdAt     DateTime @default(now())

  gatePasses    GatePass[]

  @@index([schoolId, checkInTime])
  @@index([schoolId, status])
}

model GatePass {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String   @db.ObjectId
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  visitorId   String   @db.ObjectId
  visitor     Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  studentId   String?  @db.ObjectId
  studentName String?
  issuedBy    String
  issuedAt    DateTime @default(now())
  purpose     String?
  status      String   @default("ACTIVE")

  @@index([schoolId, issuedAt])
  @@index([visitorId])
}

model HostMapping {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId      String   @db.ObjectId
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  visitType     String
  notifyStaffId String
  createdAt     DateTime @default(now())

  @@index([schoolId, visitType])
}

// ---------------------------------------------------------------------------
// Inventory Management
// ---------------------------------------------------------------------------

model InventoryItem {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId      String   @db.ObjectId
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String
  category      String?
  currentStock  Int      @default(0)
  reorderLevel  Int      @default(10)
  unitPrice     Float    @default(0)
  unit          String   @default("pcs")
  location      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchases     PurchaseRecord[]
  issues        IssueLog[]

  @@index([schoolId, category])
}

model PurchaseRecord {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId     String   @db.ObjectId
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  itemId       String   @db.ObjectId
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity     Int
  vendorName   String?
  invoiceNo    String?
  totalCost    Float?
  purchaseDate DateTime @default(now())
  recordedBy   String?
  createdAt    DateTime @default(now())

  @@index([schoolId, itemId])
}

model IssueLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId   String   @db.ObjectId
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  itemId     String   @db.ObjectId
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity   Int
  department String?
  issuedTo   String?
  issuedAt   DateTime @default(now())
  recordedBy String?
  createdAt  DateTime @default(now())

  @@index([schoolId, itemId])
}

// ---------------------------------------------------------------------------
// Building & Hostel Management
// ---------------------------------------------------------------------------

model Building {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("Hostel")
  floors    Int      @default(1)
  createdAt DateTime @default(now())

  rooms     HostelRoom[]

  @@index([schoolId])
}

model HostelRoom {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  buildingId  String   @db.ObjectId
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floor       Int      @default(0)
  roomNumber  String
  bedCount    Int      @default(2)
  roomType    String   @default("Standard")
  status      String   @default("AVAILABLE")
  createdAt   DateTime @default(now())

  assignments BedAssignment[]

  @@unique([buildingId, roomNumber])
}

model BedAssignment {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  roomId     String     @db.ObjectId
  room       HostelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bedNumber  Int
  studentId  String     @db.ObjectId
  session    String     @default("2024-2025")
  createdAt  DateTime   @default(now())

  @@unique([roomId, bedNumber])
}

model MaintenanceRequest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String   @db.ObjectId
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roomId      String?  @db.ObjectId
  description String
  priority    String   @default("MEDIUM")
  status      String   @default("PENDING")
  reportedBy  String?
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId, status])
}

// ---------------------------------------------------------------------------
// Copy Checking
// ---------------------------------------------------------------------------

model CopyCheckBatch {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId       String   @db.ObjectId
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject        String
  cls            String
  section        String
  term           String
  totalCopies    Int
  assignedToId   String?  @db.ObjectId
  assignedToName String?
  dueDate        DateTime?
  completedCount Int      @default(0)
  status         String   @default("NOT_STARTED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entries        CopyCheckEntry[]

  @@index([schoolId, assignedToId])
  @@index([schoolId, status])
}

model CopyCheckEntry {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  batchId     String   @db.ObjectId
  batch       CopyCheckBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentId   String   @db.ObjectId
  studentName String?
  marks       Float?
  maxMarks    Float    @default(100)
  checkedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([batchId])
}

