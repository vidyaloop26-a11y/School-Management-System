# Copy this file to .env and fill in real values. NEVER commit .env.

NODE_ENV=development
PORT=5000
DATABASE_URL=mongodb://127.0.0.1:27017/vidyaloop
JWT_ACCESS_SECRET=change-me-long-random-string
JWT_REFRESH_SECRET=change-me-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3000

# First super admin — used by `npm run bootstrap` and `npm run seed`
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Demo school + school admin — used by `npm run seed`
SEED_SCHOOL_NAME=
SEED_SCHOOL_CODE=
SEED_SCHOOL_BOARD=
SEED_SCHOOL_ADDRESS=
SEED_SCHOOL_SESSION=
SEED_SCHOOL_ADMIN_NAME=
SEED_SCHOOL_ADMIN_EMAIL=
SEED_SCHOOL_ADMIN_PASSWORD=
